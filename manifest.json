{
  "manifest_version": 3,
  "name": "ThreadLine Archive",
  "version": "0.7.0",
  "description": "Save ChatGPT conversations and their accessible files to local archives.",
  "homepage_url": "https://github.com/siskosun/threadline-chatgpt-export",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Export as Markdown",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "service_worker": "src/background.js"
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "optional_host_permissions": [
    "https://oaiusercontent.com/*",
    "https://*.oaiusercontent.com/*",
    "https://oaistatic.com/*",
    "https://*.oaistatic.com/*",
    "https://images.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "lib/marked.umd.js",
        "src/zip.js",
        "src/render.js",
        "src/content.js",
        "src/picker.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "threadline-archive@example.org",
      "strict_min_version": "121.0"
    }
  },
  "permissions": [
    "storage",
    "scripting"
  ]
}
